# Neon connection string (postgresql:// or postgresql+psycopg:// both work)
DATABASE_URL=
# Private key from Vapi dashboard > API keys (used only by scripts, never by the web app)
VAPI_API_KEY=
# Shared secret Vapi sends in the x-vapi-secret header; generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
VAPI_WEBHOOK_SECRET=
# Public base URL of the deployed API (e.g. https://your-app.vercel.app)
PUBLIC_BASE_URL=
# Optional
CLINIC_TIMEZONE=America/New_York
INTAKE_PHONE_NUMBER=+17579798389
